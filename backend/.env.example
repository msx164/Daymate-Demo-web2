# Official documentation lists the non-Pro model below as free. Check your account's current price.
DAYMATE_AI_PROVIDER=compatible
DAYMATE_AI_BASE_URL=https://api.siliconflow.cn/v1
DAYMATE_AI_API_KEY=
DAYMATE_AI_MODEL=Qwen/Qwen2.5-7B-Instruct
